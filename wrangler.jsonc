{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comedor",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "comedor.programandoando.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}

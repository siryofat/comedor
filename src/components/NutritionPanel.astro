---
import type { Nutrition } from '../lib/menu'

interface Props {
  nutrition: Nutrition
}

const { nutrition: n } = Astro.props

const fmt = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 })

const macros = [
  {
    label: 'Hidratos',
    grams: n.carbohydrates_g,
    percent: n.carbohydrates_percent,
    fill: '#f2b544',
  },
  { label: 'Proteínas', grams: n.protein_g, percent: n.protein_percent, fill: '#2e9e7a' },
  { label: 'Grasas', grams: n.fat_g, percent: n.fat_percent, fill: '#6b3a1e' },
]
// Los porcentajes de la fuente no siempre suman 100: la barra se escala a su suma.
const total = macros.reduce((sum, m) => sum + m.percent, 0) || 1
---

<section aria-labelledby="nutrition-title" class="rounded-2xl bg-page p-5">
  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 id="nutrition-title" class="font-extrabold">Valores nutricionales</h3>
    <p class="text-sm font-semibold text-muted">
      {fmt.format(n.energy_percent)} % de la energía del día
    </p>
  </div>

  <p class="mt-3 flex items-baseline gap-2">
    <span class="text-4xl leading-none font-black tabular-nums">{fmt.format(n.energy_kcal)}</span>
    <span class="font-bold text-muted">kcal</span>
  </p>

  <div class="mt-4 flex h-3 gap-0.5 overflow-hidden rounded-full" aria-hidden="true">
    {macros.map((m) => <span style={`flex:${m.percent / total} 0 0;background:${m.fill}`} />)}
  </div>

  <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-4">
    {
      macros.map((m) => (
        <div>
          <dt class="flex items-center gap-1.5 text-sm font-bold text-muted">
            <span
              class="size-2.5 shrink-0 rounded-sm"
              style={`background:${m.fill}`}
              aria-hidden="true"
            />
            {m.label}
          </dt>
          <dd class="mt-0.5 tabular-nums">
            <span class="text-lg font-extrabold">{fmt.format(m.grams)} g</span>
            <span class="ml-1 text-sm font-semibold text-muted">{fmt.format(m.percent)} %</span>
          </dd>
        </div>
      ))
    }
    <div>
      <dt class="text-sm font-bold text-muted">Fibra</dt>
      <dd class="mt-0.5 text-lg font-extrabold tabular-nums">{fmt.format(n.fiber_g)} g</dd>
    </div>
  </dl>
</section>

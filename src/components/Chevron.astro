---
interface Props {
  direction: 'left' | 'right'
}

const { direction } = Astro.props
---

<svg
  viewBox="0 0 24 24"
  class="size-5"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={direction === 'left' ? 'M15 5l-7 7 7 7' : 'M9 5l7 7-7 7'}></path>
</svg>

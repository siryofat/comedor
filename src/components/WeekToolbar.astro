---
import PagerLink from './PagerLink.astro'
import { formatDate, menuIndex, type CalendarWeek } from '../lib/menu'
import { dayHref, weekHref } from '../lib/routes'
import { weekStyle } from '../lib/weekColors'

interface Props {
  week: CalendarWeek
  view: 'day' | 'week'
  /** Día seleccionado (0 = lunes) en la vista de día. */
  dayIndex?: number
}

const { week, view, dayIndex = 0 } = Astro.props
const { menu } = menuIndex
const { prev, next } = menuIndex.weekNeighbors(week.start)

/** En la vista de día se conserva el mismo día de la semana si tiene menú. */
function hrefFor(w: CalendarWeek | undefined) {
  if (!w) return undefined
  if (view === 'week') return weekHref(w.start)
  const day = w.days[dayIndex]?.schoolDay ?? w.days.find((d) => d.schoolDay)!.schoolDay!
  return dayHref(day.date)
}

const last = week.days.findLast((d) => d.schoolDay)!.date
const sameMonth = week.start.slice(0, 7) === last.slice(0, 7)
const range = sameMonth
  ? `${formatDate(week.start, { day: 'numeric' })} al ${formatDate(last, { day: 'numeric', month: 'long' })}`
  : `${formatDate(week.start, { day: 'numeric', month: 'long' })} al ${formatDate(last, { day: 'numeric', month: 'long' })}`

const firstSchoolDay = week.days.find((d) => d.schoolDay)!.date
const views = [
  {
    key: 'day',
    label: 'Día',
    href: dayHref(view === 'day' ? week.days[dayIndex].date : firstSchoolDay),
  },
  { key: 'week', label: 'Semana', href: weekHref(week.start) },
]
const prevLabel = prev
  ? `Semana del ${formatDate(prev.start, { day: 'numeric', month: 'long' })}`
  : ''
const nextLabel = next
  ? `Semana del ${formatDate(next.start, { day: 'numeric', month: 'long' })}`
  : ''
---

<div
  class="mb-5 flex flex-wrap items-center justify-between gap-x-6 gap-y-4"
  style={weekStyle(week.menuWeek)}
>
  <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex gap-2">
      <PagerLink href={hrefFor(prev)} label={prevLabel} direction="left" />
      <PagerLink href={hrefFor(next)} label={nextLabel} direction="right" />
    </div>
    <p class="font-display text-2xl font-semibold lining-nums">{range}</p>
    <p
      class="rounded-lg bg-(--wk-tint) px-2.5 py-1 text-sm font-extrabold text-(--wk-deep)"
      title="Semana de la rotación del menú"
    >
      Semana {week.menuWeek} de {menu.weekly_menus.length}
    </p>
  </div>

  <div class="flex items-center gap-3">
    <a
      href={hrefFor(week)}
      data-nav={view === 'day' ? 'day' : 'week'}
      class="inline-flex min-h-11 items-center rounded-xl px-3 font-bold text-muted hover:text-ink"
    >
      Hoy
    </a>
    <nav aria-label="Vista" class="flex rounded-xl bg-line-soft p-1">
      {
        views.map((v) => (
          <a
            href={v.href}
            aria-current={v.key === view ? 'page' : undefined}
            class="inline-flex min-h-9 items-center rounded-lg px-4 text-sm font-bold text-muted hover:text-ink aria-[current=page]:bg-surface aria-[current=page]:text-ink aria-[current=page]:shadow-[0_1px_2px_rgb(45_31_20/0.12)]"
          >
            {v.label}
          </a>
        ))
      }
    </nav>
  </div>
</div>
